# generated from
# rosidl_cmake/cmake/template/rosidl_cmake_export_typesupport_libraries.cmake.in

set(_exported_typesupport_libraries
  "@_ROSIDL_CMAKE_EXPORT_TYPESUPPORT_LIBRARIES@")

# populate @PROJECT_NAME@_LIBRARIES_<suffix>
if(NOT _exported_typesupport_libraries STREQUAL "")
  # loop over typesupport libraries
  foreach(_tuple ${_exported_typesupport_libraries})
    string(REPLACE ":" ";" _tuple "${_tuple}")
    list(GET _tuple 0 _suffix)
    list(GET _tuple 1 _library)

    if(NOT IS_ABSOLUTE "${_library}")
      # search for library target relative to this CMake file
      unset(_@PROJECT_NAME@_exported_typesupport_library)
      unset(_@PROJECT_NAME@_exported_typesupport_library CACHE)
      find_library(
        _@PROJECT_NAME@_exported_typesupport_library NAMES "${_library}"
        PATHS "${@PROJECT_NAME@_DIR}/../../../lib"
        NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH
      )

      if(NOT _@PROJECT_NAME@_exported_typesupport_library)
        unset(_@PROJECT_NAME@_exported_typesupport_library)
        unset(_@PROJECT_NAME@_exported_typesupport_library CACHE)
        set(_@PROJECT_NAME@_exported_typesupport_library_filenames
          "${_library}"
          "${CMAKE_SHARED_LIBRARY_PREFIX}${_library}${CMAKE_SHARED_LIBRARY_SUFFIX}"
          "${CMAKE_STATIC_LIBRARY_PREFIX}${_library}${CMAKE_STATIC_LIBRARY_SUFFIX}"
        )
        find_file(
          _@PROJECT_NAME@_exported_typesupport_library
          NAMES ${_@PROJECT_NAME@_exported_typesupport_library_filenames}
          PATHS "${@PROJECT_NAME@_DIR}/../../../lib"
          NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH
        )
        unset(_@PROJECT_NAME@_exported_typesupport_library_filenames)
      endif()

      if(NOT _@PROJECT_NAME@_exported_typesupport_library)
        # the library wasn't found
        message(FATAL_ERROR
          "Package '@PROJECT_NAME@' exports the typesupport library '${_library}' which couldn't be found")
      elseif(NOT IS_ABSOLUTE "${_@PROJECT_NAME@_exported_typesupport_library}")
        # the found library must be an absolute path
        message(FATAL_ERROR
          "Package '@PROJECT_NAME@' found the typesupport library '${_library}' at '${_@PROJECT_NAME@_exported_typesupport_library}' "
          "which is not an absolute path")
      elseif(NOT EXISTS "${_@PROJECT_NAME@_exported_typesupport_library}")
        # the found library must exist
        message(FATAL_ERROR "Package '@PROJECT_NAME@' found the typesupport library '${_@PROJECT_NAME@_exported_typesupport_library}' which doesn't exist")
      else()
        list(APPEND @PROJECT_NAME@_LIBRARIES${_suffix} ${_cfg} "${_@PROJECT_NAME@_exported_typesupport_library}")
      endif()

      unset(_@PROJECT_NAME@_exported_typesupport_library)
      unset(_@PROJECT_NAME@_exported_typesupport_library CACHE)

    else()
      if(NOT EXISTS "${_library}")
        # the found library must exist
        message(WARNING "Package '@PROJECT_NAME@' exports the typesupport library '${_library}' which doesn't exist")
      else()
        list(APPEND @PROJECT_NAME@_LIBRARIES${_suffix} "${_library}")
      endif()
    endif()
  endforeach()
endif()
